---
import { identite, accroche, contact } from '../data/profil';
---

<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="shell">
    {
      identite.disponible && (
        <p class="reveal label flex items-center gap-2.5">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-70 motion-safe:animate-ping" />
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent" />
          </span>
          {identite.mentionDisponibilite} — {identite.ville}
        </p>
      )
    }

    <h1
      class="reveal mt-7 text-[clamp(2.5rem,7.2vw,5.25rem)] leading-[1.04] font-medium tracking-[-0.035em]"
      style="--reveal-delay:60ms"
    >
      {accroche.h1[0]}<br />
      <span class="text-fg-3">{accroche.h1[1]}</span> {accroche.h1[2]}
    </h1>

    <p
      class="reveal mt-8 max-w-[54ch] text-fg-2 sm:text-[1.125rem]"
      style="--reveal-delay:120ms"
    >
      {accroche.paragraphe}
    </p>

    <div
      class="reveal mt-10 flex flex-wrap items-center gap-3"
      style="--reveal-delay:180ms"
    >
      <a
        href="#travail"
        class="rounded-sm bg-fg px-6 py-3.5 text-[0.9rem] font-medium text-ink-950 transition-opacity hover:opacity-85"
      >
        Voir les études de cas
      </a>
      <a
        href="#cv"
        class="rounded-sm border border-ink-700 px-6 py-3.5 text-[0.9rem] text-fg-2 transition-colors hover:border-ink-700 hover:text-fg"
      >
        Mon CV
      </a>
      <a
        href={`mailto:${contact.email}`}
        class="link-u px-2 py-3.5 text-[0.9rem] text-fg-3 transition-colors hover:text-fg"
      >
        {contact.email}
      </a>
    </div>

    <dl
      class="reveal mt-20 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-ink-800 pt-8 sm:grid-cols-4"
      style="--reveal-delay:240ms"
    >
      <div>
        <dt class="label">Expérience</dt>
        <dd class="mt-1.5 text-[1.375rem] font-medium tracking-tight">
          {identite.anneesExperience} ans
        </dd>
      </div>
      <div>
        <dt class="label">Poste actuel</dt>
        <dd class="mt-1.5 text-[1.375rem] font-medium tracking-tight">
          {identite.employeurActuel}
        </dd>
      </div>
      <div>
        <dt class="label">Base</dt>
        <dd class="mt-1.5 text-[1.375rem] font-medium tracking-tight">
          {identite.ville}
        </dd>
      </div>
      <div>
        <dt class="label">Langues</dt>
        <dd class="mt-1.5 text-[1.375rem] font-medium tracking-tight">
          Français · Anglais
        </dd>
      </div>
    </dl>
  </div>
</section>
