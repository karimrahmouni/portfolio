---
interface Props {
  titre: string;
  secteur: string;
  texte: string;
  stack: readonly string[];
  delai?: number;
}

const { titre, secteur, texte, stack, delai = 0 } = Astro.props;
---

<article
  class="reveal group border-t border-ink-800 pt-6 transition-colors duration-300 hover:border-ink-700"
  style={`--reveal-delay:${delai}ms`}
>
  <p class="label">{secteur}</p>
  <h3 class="mt-3 text-[1.2rem] leading-snug">{titre}</h3>
  <p class="mt-3 text-[0.925rem] text-fg-2">{texte}</p>
  <ul class="mt-5 flex flex-wrap gap-x-2 gap-y-2">
    {
      stack.map((t) => (
        <li class="rounded-sm border border-ink-800 px-2.5 py-1 font-mono text-[0.6875rem] text-fg-3">
          {t}
        </li>
      ))
    }
  </ul>
</article>
