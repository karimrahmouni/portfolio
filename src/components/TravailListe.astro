---
import { render, type CollectionEntry } from 'astro:content';
import ProjetCarte from './ProjetCarte.astro';
import { projets } from '../data/profil';

interface Props {
  etudes: CollectionEntry<'travail'>[];
}

const { etudes } = Astro.props;

// Le contenu Markdown est rendu ici même : tout le site tient dans une page.
const rendus = await Promise.all(
  etudes.map(async (etude) => ({
    etude,
    Contenu: (await render(etude)).Content,
  }))
);
---

<section id="travail" class="section-gap scroll-mt-24" aria-labelledby="titre-travail">
  <div class="shell">
    <p class="reveal label">02 — Travail</p>
    <h2
      id="titre-travail"
      class="reveal mt-4 max-w-[26ch] text-[clamp(1.75rem,3.6vw,2.5rem)]"
      style="--reveal-delay:60ms"
    >
      Deux systèmes racontés en détail, quatre autres en bref.
    </h2>
    <p class="reveal mt-5 max-w-[58ch] text-fg-2" style="--reveal-delay:100ms">
      Les projets ci-dessous ont été livrés en sous-traitance pour des clients au
      Maroc. Les noms des clients ne sont pas divulgués ; ce qui est raconté, ce
      sont les décisions techniques et ce qu'elles ont coûté.
    </p>

    <!-- ===== Études de cas ===== -->
    <div class="mt-16 flex flex-col">
      {
        rendus.map(({ etude, Contenu }, i) => (
          <article
            id={etude.id}
            class="reveal scroll-mt-24 border-t border-ink-800 py-10 sm:py-12"
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="grid gap-6 md:grid-cols-12 md:gap-10">
              <div class="md:col-span-4">
                <p class="label">{etude.data.secteur}</p>
                <h3 class="mt-4 text-[clamp(1.4rem,2.6vw,1.9rem)] leading-tight">
                  {etude.data.titre}
                </h3>
                <p class="mt-3 font-mono text-[0.7rem] text-fg-3">
                  {etude.data.contexte}
                </p>
              </div>

              <div class="md:col-span-8">
                <p class="max-w-[58ch] text-fg-2">{etude.data.resume}</p>

                <ul class="mt-6 flex flex-wrap gap-2">
                  {etude.data.stack.map((t) => (
                    <li class="rounded-sm border border-ink-800 px-2.5 py-1 font-mono text-[0.6875rem] text-fg-3">
                      {t}
                    </li>
                  ))}
                </ul>

                <details class="etude mt-7">
                  <summary>
                    <span class="fleche" aria-hidden="true">
                      →
                    </span>
                    <span class="txt-ferme">Lire l'étude de cas</span>
                    <span class="txt-ouvert">Replier l'étude de cas</span>
                  </summary>
                  <div class="prose-kr mt-10">
                    <Contenu />
                  </div>
                </details>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- ===== Autres projets ===== -->
    <h3 class="reveal label mt-24">Autres réalisations</h3>
    <div class="mt-8 grid gap-x-10 gap-y-12 sm:grid-cols-2">
      {
        projets.map((p, i) => (
          <ProjetCarte
            titre={p.titre}
            secteur={p.secteur}
            texte={p.texte}
            stack={p.stack}
            delai={(i % 2) * 90}
          />
        ))
      }
    </div>
  </div>
</section>
