---
import { parcours, formation } from '../data/profil';
---

<section id="parcours" class="section-gap scroll-mt-24" aria-labelledby="titre-parcours">
  <div class="shell">
    <p class="reveal label">03 — Parcours</p>
    <h2
      id="titre-parcours"
      class="reveal mt-4 text-[clamp(1.75rem,3.6vw,2.5rem)]"
      style="--reveal-delay:60ms"
    >
      Onze ans, trois entreprises.
    </h2>

    <ol class="mt-16 flex flex-col">
      {
        parcours.map((poste, i) => (
          <li
            class="reveal grid gap-4 border-t border-ink-800 py-9 md:grid-cols-12 md:gap-10"
            style={`--reveal-delay:${i * 80}ms`}
          >
            <div class="md:col-span-4">
              <p class="flex items-center gap-2.5 font-mono text-[0.75rem] text-fg-3">
                {poste.debut} — {poste.fin}
                {poste.actuel && (
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent" />
                )}
              </p>
              <p class="mt-3 text-[1.05rem] font-medium">{poste.entreprise}</p>
              <p class="text-[0.85rem] text-fg-3">{poste.lieu}</p>
            </div>

            <div class="md:col-span-8">
              <h3 class="text-[1.2rem] leading-snug">{poste.poste}</h3>
              <ul class="mt-4 flex flex-col gap-2">
                {poste.points.map((pt) => (
                  <li class="relative pl-5 text-[0.95rem] text-fg-2">
                    <span
                      aria-hidden="true"
                      class="absolute left-0 top-[0.72em] h-px w-2 bg-ink-700"
                    />
                    {pt}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-20">
      <h3 class="label">Formation</h3>
      <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-3">
        {
          formation.map((f) => (
            <div class="border-t border-ink-800 pt-5">
              <dt class="font-mono text-[0.75rem] text-fg-3">{f.annee}</dt>
              <dd class="mt-2">
                <span class="block text-[1.05rem] font-medium">{f.intitule}</span>
                <span class="mt-1 block text-[0.875rem] text-fg-2">
                  {f.etablissement}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
