---
import { identite, navigation, contact } from '../data/profil';

const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const estPageCourante = (href: string) =>
  !href.includes('#') && href.replace(/\/$/, '') === chemin;
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  id="entete"
>
  <div class="shell flex h-16 items-center justify-between sm:h-20">
    <a
      href="#haut"
      class="text-[0.95rem] font-medium tracking-tight"
      aria-label={`${identite.nomComplet} — haut de page`}
    >
      {identite.initiales}<span class="text-accent">.</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-8 md:flex">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={estPageCourante(item.href) ? 'page' : undefined}
            class:list={[
              'link-u text-[0.9rem] transition-colors hover:text-fg',
              estPageCourante(item.href) ? 'text-fg' : 'text-fg-2',
            ]}
          >
            {item.libelle}
          </a>
        ))
      }
      <a
        href={`mailto:${contact.email}`}
        class="rounded-sm bg-fg px-4 py-2 text-[0.85rem] font-medium text-ink-950 transition-opacity hover:opacity-85"
      >
        Me contacter
      </a>
    </nav>

    <button
      type="button"
      id="menu-bouton"
      class="relative z-50 -mr-2 flex h-10 w-10 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Ouvrir le menu"
    >
      <span class="relative block h-3 w-5">
        <span
          class="absolute inset-x-0 top-0 h-px bg-fg transition-transform duration-300"
          data-barre="haut"></span>
        <span
          class="absolute inset-x-0 bottom-0 h-px bg-fg transition-transform duration-300"
          data-barre="bas"></span>
      </span>
    </button>
  </div>

  <div class="rule opacity-0 transition-opacity duration-300" data-nav-rule></div>
</header>

<div
  id="menu-mobile"
  hidden
  class="fixed inset-0 z-40 bg-ink-950 px-5 pt-24 md:hidden"
>
  <nav aria-label="Navigation mobile" class="flex flex-col gap-1">
    {
      navigation.map((item) => (
        <a
          href={item.href}
          class="border-b border-ink-800 py-4 text-2xl font-medium tracking-tight"
        >
          {item.libelle}
        </a>
      ))
    }
    <a
      href={`mailto:${contact.email}`}
      class="mt-6 rounded-sm bg-fg px-5 py-3 text-center font-medium text-ink-950"
    >
      Me contacter
    </a>
  </nav>
</div>

<script>
  const entete = document.getElementById('entete');
  const bouton = document.getElementById('menu-bouton');
  const panneau = document.getElementById('menu-mobile');
  const filet = document.querySelector<HTMLElement>('[data-nav-rule]');

  /* --- Filet sous l'en-tête une fois le défilement amorcé --- */
  if (entete && filet) {
    const surDefilement = () => {
      const actif = window.scrollY > 24;
      entete.classList.toggle('bg-ink-950/85', actif);
      entete.classList.toggle('backdrop-blur-md', actif);
      filet.classList.toggle('opacity-0', !actif);
    };
    window.addEventListener('scroll', surDefilement, { passive: true });
    surDefilement();
  }

  /* --- Menu mobile : ouverture, piège de focus, fermeture --- */
  if (bouton && panneau) {
    let ouvert = false;
    let dernierFocus: HTMLElement | null = null;

    const focusables = () =>
      Array.from(
        panneau.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      );

    const definir = (etat: boolean) => {
      ouvert = etat;
      panneau.hidden = !etat;
      bouton.setAttribute('aria-expanded', String(etat));
      bouton.setAttribute('aria-label', etat ? 'Fermer le menu' : 'Ouvrir le menu');
      document.documentElement.style.overflow = etat ? 'hidden' : '';

      const haut = bouton.querySelector<HTMLElement>('[data-barre="haut"]');
      const bas = bouton.querySelector<HTMLElement>('[data-barre="bas"]');
      if (haut && bas) {
        haut.style.transform = etat ? 'translateY(5.5px) rotate(45deg)' : '';
        bas.style.transform = etat ? 'translateY(-5.5px) rotate(-45deg)' : '';
      }

      if (etat) {
        dernierFocus = document.activeElement as HTMLElement;
        focusables()[0]?.focus();
      } else {
        (dernierFocus ?? bouton).focus();
      }
    };

    bouton.addEventListener('click', () => definir(!ouvert));
    panneau.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) definir(false);
    });

    document.addEventListener('keydown', (e) => {
      if (!ouvert) return;
      if (e.key === 'Escape') {
        definir(false);
        return;
      }
      if (e.key !== 'Tab') return;

      // Piège de focus : le panneau ouvert ne laisse pas fuir la tabulation.
      const cibles = [bouton, ...focusables()];
      const premier = cibles[0];
      const dernier = cibles[cibles.length - 1];
      if (e.shiftKey && document.activeElement === premier) {
        e.preventDefault();
        dernier?.focus();
      } else if (!e.shiftKey && document.activeElement === dernier) {
        e.preventDefault();
        premier?.focus();
      }
    });

    // Le passage en écran large referme le panneau resté ouvert.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && ouvert) definir(false);
    });
  }
</script>
