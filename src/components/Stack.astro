---
import { stack, complements } from '../data/profil';

const autres = [
  { titre: 'Langages', valeurs: complements.langages },
  { titre: 'Front-end', valeurs: complements.frontEnd },
  { titre: 'Conception', valeurs: complements.conception },
  { titre: 'Conformité', valeurs: complements.conformite },
];
---

<section id="stack" class="section-gap scroll-mt-24" aria-labelledby="titre-stack">
  <div class="shell">
    <p class="reveal label">04 — Stack</p>
    <h2
      id="titre-stack"
      class="reveal mt-4 max-w-[24ch] text-[clamp(1.75rem,3.6vw,2.5rem)]"
      style="--reveal-delay:60ms"
    >
      Rangée par rôle dans le système, pas par ordre alphabétique.
    </h2>
    <p class="reveal mt-5 max-w-[56ch] text-fg-2" style="--reveal-delay:100ms">
      Une liste d'outils ne dit rien de la manière dont on s'en sert. Celle-ci
      suit le trajet d'une requête, de son point d'entrée jusqu'à la
      journalisation de ce qu'elle a produit.
    </p>

    <div class="mt-16 flex flex-col">
      {
        stack.map((groupe, i) => (
          <div
            class="reveal grid gap-4 border-t border-ink-800 py-8 md:grid-cols-12 md:gap-10"
            style={`--reveal-delay:${i * 70}ms`}
          >
            <div class="md:col-span-4">
              <h3 class="text-[1.15rem]">{groupe.role}</h3>
              <p class="mt-1.5 text-[0.85rem] text-fg-3">{groupe.precision}</p>
            </div>
            <ul class="flex flex-wrap gap-2 md:col-span-8 md:items-start">
              {groupe.outils.map((o) => (
                <li class="rounded-sm border border-ink-800 bg-ink-900 px-3 py-1.5 font-mono text-[0.75rem] text-fg-2">
                  {o}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <dl class="reveal mt-14 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
      {
        autres.map((bloc) => (
          <div>
            <dt class="label">{bloc.titre}</dt>
            <dd class="mt-2 text-[0.9rem] text-fg-2">{bloc.valeurs.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
