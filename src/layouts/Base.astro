---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import Intro from '../components/Intro.astro';
import { meta, identite, contact, liensActifs } from '../data/profil';

interface Props {
  titre?: string;
  description?: string;
  /** Joue le rideau d'intro. Réservé à la page d'accueil. */
  intro?: boolean;
  /** Insère les données structurées Person. Une seule page doit le faire. */
  donneesStructurees?: boolean;
}

const {
  titre = meta.titreDefaut,
  description = meta.descriptionDefaut,
  intro = false,
  donneesStructurees = false,
} = Astro.props;

const canonique = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identite.nomComplet,
  givenName: identite.prenom,
  familyName: identite.nom,
  jobTitle: identite.titreLong,
  description: meta.descriptionDefaut,
  email: `mailto:${contact.email}`,
  telephone: contact.telephoneUri,
  url: new URL('/', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: identite.ville,
    addressCountry: 'MA',
  },
  worksFor: {
    '@type': 'Organization',
    name: identite.employeurActuel,
  },
  knowsAbout: [
    'ASP.NET Core',
    'C#',
    'Architecture logicielle',
    'SQL Server',
    'Azure',
    'RabbitMQ',
    'Sécurité des données',
  ],
  knowsLanguage: ['fr', 'en'],
  ...(liensActifs.length > 0 ? { sameAs: liensActifs.map((l) => l.url) } : {}),
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Marque l'activation de JavaScript : les états masqués des animations
        ne s'appliquent qu'à partir de là. Sans ce drapeau, le contenu reste
        visible en toutes circonstances. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta name="author" content={identite.nomComplet} />
    <meta name="theme-color" content="#0c0d0f" />
    <meta name="color-scheme" content="dark" />

    <link
      rel="preload"
      href="/fonts/geist-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={identite.nomComplet} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${identite.nomComplet} — ${identite.titre}`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titre} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230c0d0f'/%3E%3Ctext x='32' y='43' font-family='system-ui,sans-serif' font-size='28' font-weight='500' fill='%23c8ff4d' text-anchor='middle'%3EKR%3C/text%3E%3C/svg%3E"
    />

    {
      donneesStructurees && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(personne)}
        />
      )
    }
  </head>

  <body id="haut">
    {intro && <Intro />}

    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-sm focus:bg-accent focus:px-4 focus:py-2 focus:font-medium focus:text-ink-950"
    >
      Aller au contenu
    </a>

    <Nav />

    <main id="contenu">
      <slot />
    </main>

    <Pied />

    <script>
      /* Révélation au défilement — un seul observateur pour toute la page. */
      const cibles = document.querySelectorAll<HTMLElement>('.reveal');

      if (
        cibles.length > 0 &&
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const observateur = new IntersectionObserver(
          (entrees, obs) => {
            for (const entree of entrees) {
              if (!entree.isIntersecting) continue;
              entree.target.classList.add('is-in');
              obs.unobserve(entree.target);
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
        );
        cibles.forEach((el) => observateur.observe(el));
      } else {
        cibles.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
